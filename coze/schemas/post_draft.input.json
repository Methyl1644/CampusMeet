{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campusmate/coze/schemas/post_draft.input.json",
  "title": "PostDraftInput",
  "description": "CampusMate 多轮发帖工作流的实际后端入参。",
  "type": "object",
  "required": ["message", "kind", "field_states", "candidate_tags"],
  "additionalProperties": false,
  "properties": {
    "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "draft": { "type": "string", "description": "当前草稿 JSON 字符串" },
    "user_skills": { "type": "string" },
    "kind": { "type": "string", "enum": ["topic_team", "casual_invitation"] },
    "field_states": { "type": "object", "additionalProperties": true },
    "candidate_tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tag_id", "canonical_name"],
        "additionalProperties": true,
        "properties": {
          "tag_id": { "type": "string" },
          "canonical_name": { "type": "string" }
        }
      }
    },
    "topic_id": { "type": ["string", "null"] }
  }
}
