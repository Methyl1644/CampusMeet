{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campusmate/coze/schemas/classify_review.input.json",
  "title": "ClassifyReviewInput",
  "description": "标签推荐与风险初筛工作流的后端实际入参。标题和正文已由后端规则引擎脱敏。",
  "type": "object",
  "required": ["title", "description", "candidate_tags"],
  "additionalProperties": false,
  "properties": {
    "title": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 5000 },
    "candidate_tags": {
      "type": "array",
      "maxItems": 120,
      "items": {
        "type": "object",
        "required": ["tag_id", "canonical_name", "category"],
        "additionalProperties": true,
        "properties": {
          "tag_id": { "type": "string", "minLength": 1 },
          "canonical_name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["activity", "skill", "role", "level", "audience"] },
          "display_color": { "type": "string" }
        }
      }
    }
  }
}
