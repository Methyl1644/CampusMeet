{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campusmate/coze/schemas/classify_review.output.json",
  "title": "ClassifyReviewOutput",
  "description": "标签推荐与风险初筛的受控输出。标签候选只建议，最终发布和拦截由后端决定。",
  "type": "object",
  "required": ["main_category", "tag_ids", "unknown_concepts", "risk_level", "suggestions"],
  "additionalProperties": false,
  "properties": {
    "main_category": {
      "type": "string",
      "enum": ["竞赛与项目", "学习与科研", "体育与健身", "旅行与户外", "校园生活", "拼团与AA"]
    },
    "tag_ids": {
      "type": "array",
      "items": { "type": "string" },
      "maxItems": 8,
      "uniqueItems": true,
      "description": "只能从输入 candidate_tags 的 tag_id 中选择。"
    },
    "unknown_concepts": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["name", "category", "reason"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 30 },
          "category": { "type": "string", "enum": ["activity", "skill", "role", "level", "audience"] },
          "reason": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "suggestions": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 5 }
  }
}
