{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campusmate/coze/schemas/post_draft.output.json",
  "title": "PostDraftOutput",
  "description": "需求拆解与发帖工作流的受控输出。",
  "type": "object",
  "required": ["reply", "draft", "is_complete", "field_states", "suggested_tag_ids"],
  "additionalProperties": false,
  "properties": {
    "reply": { "type": "string", "maxLength": 500 },
    "draft": {
      "type": "object",
      "required": [
        "activity_name",
        "target_members",
        "needed_roles",
        "weekly_hours",
        "school_scope",
        "deadline",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "activity_name": { "type": "string" },
        "target_members": { "type": "integer", "minimum": 0 },
        "needed_roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "weekly_hours": { "type": "string" },
        "school_scope": { "type": "string" },
        "deadline": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "is_complete": { "type": "boolean" },
    "field_states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "status"],
        "additionalProperties": false,
        "properties": {
          "value": {},
          "status": { "type": "string", "enum": ["confirmed", "none", "unknown", "skipped", "pending"] }
        }
      }
    },
    "suggested_tag_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 4, "uniqueItems": true },
    "candidate_tags": { "type": "array", "items": { "type": "object" }, "maxItems": 120 },
    "next_field": { "type": ["string", "null"] },
    "missing_fields": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "degraded": { "type": "boolean" }
  }
}
