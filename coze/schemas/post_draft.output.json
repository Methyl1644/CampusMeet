{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campusmate/coze/schemas/post_draft.output.json",
  "title": "PostDraftOutput",
  "description": "需求拆解与发帖工作流的受控输出。",
  "type": "object",
  "required": ["reply", "draft", "is_complete", "field_states", "suggested_tag_ids"],
  "additionalProperties": false,
  "properties": {
    "reply": { "type": "string", "maxLength": 500 },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activity": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "value": { "type": ["string", "null"] },
            "raw_text": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "time": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "value": { "type": ["string", "null"] },
            "raw_text": { "type": "string" },
            "normalized_time": { "type": "string" },
            "precision": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "value": { "type": ["string", "null"] },
            "raw_text": { "type": "string" },
            "normalized_location": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "people": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "total_people": { "type": ["integer", "null"], "minimum": 0 },
            "current_people": { "type": ["integer", "null"], "minimum": 0 },
            "recruit_people": { "type": ["integer", "null"], "minimum": 0 },
            "min_people": { "type": ["integer", "null"], "minimum": 0 },
            "max_people": { "type": ["integer", "null"], "minimum": 0 },
            "raw_text": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "kind": { "type": "string", "enum": ["topic_team", "casual_invitation"] },
        "topic_id": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "is_complete": { "type": "boolean" },
    "field_states": {
      "type": "object",
      "propertyNames": { "enum": ["activity", "time", "location", "people"] },
      "additionalProperties": {
        "type": "object",
        "required": ["value", "status"],
        "additionalProperties": false,
        "properties": {
          "value": {},
          "status": { "type": "string", "enum": ["confirmed", "none", "unknown", "skipped", "pending"] }
        }
      }
    },
    "suggested_tag_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 4, "uniqueItems": true },
    "candidate_tags": { "type": "array", "items": { "type": "object" }, "maxItems": 120 },
    "next_field": { "type": ["string", "null"], "enum": ["activity", "time", "location", "people", "", null] },
    "missing_fields": { "type": "array", "items": { "type": "string", "enum": ["activity", "time", "location", "people"] }, "uniqueItems": true },
    "degraded": { "type": "boolean" }
  }
}
