{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campusmate/coze/schemas/post_draft.output.json",
  "title": "PostDraftOutput",
  "type": "object",
  "required": ["reply", "draft", "is_complete", "field_states", "suggested_tag_ids"],
  "additionalProperties": false,
  "properties": {
    "reply": { "type": "string" },
    "draft": { "type": "object", "additionalProperties": true },
    "is_complete": { "type": "boolean" },
    "field_states": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["value", "status"],
        "properties": {
          "value": {},
          "status": { "type": "string", "enum": ["confirmed", "none", "unknown", "skipped", "pending"] }
        }
      }
    },
    "suggested_tag_ids": { "type": "array", "items": { "type": "string" }, "maxItems": 4 },
    "candidate_tags": { "type": "array", "items": { "type": "object" } },
    "next_field": { "type": ["string", "null"] },
    "missing_fields": { "type": "array", "items": { "type": "string" } },
    "degraded": { "type": "boolean" }
  }
}
