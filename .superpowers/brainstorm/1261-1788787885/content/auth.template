<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CampusMate | 注册、登录与认证草图</title>
<style>
:root{--ink:#202725;--muted:#6e7772;--line:#dfe5e1;--soft:#f5f7f6;--green:#18755a;--green-soft:#eaf4ef;--blue:#2f6f9f;--blue-soft:#edf4fa;--purple:#765287;--purple-soft:#f3eef6;--amber:#8b6627;--amber-soft:#fbf4e6;--red:#a5413d;--red-soft:#faeeee;--white:#fff}
*{box-sizing:border-box;letter-spacing:0}html{background:#fff}body{margin:0;color:var(--ink);font:14px/1.6 "Microsoft YaHei","PingFang SC",system-ui,sans-serif;background:#fff}button,input,select,textarea{font:inherit;color:inherit}button{cursor:pointer}button:disabled{cursor:default;opacity:.62}a{color:var(--green)}h1,h2,h3,p{margin:0}h1{font-size:28px;line-height:1.35}h2{font-size:20px;line-height:1.45}h3{font-size:15px;line-height:1.5}small{font-size:12px}.muted{color:var(--muted)}[hidden]{display:none!important}svg{display:block;width:18px;height:18px;stroke-width:1.8}.wrap{width:min(1180px,calc(100% - 48px));margin:auto}.prototype-bar{border-bottom:1px solid #d5e2db;background:#edf4f0;color:#496257}.prototype-row{min-height:40px;display:flex;align-items:center;gap:14px;font-size:12px}.prototype-row strong{color:#315848}.demo-controls{margin-left:auto;display:flex;align-items:center;gap:9px}.demo-controls select{height:30px;border:1px solid #c8d8cf;background:white;border-radius:5px;padding:0 28px 0 8px;font-size:12px}.icon-button{width:32px;height:32px;border:1px solid var(--line);border-radius:6px;background:#fff;display:grid;place-items:center;padding:0}.site-header{border-bottom:1px solid var(--line)}.header-row{height:70px;display:flex;align-items:center;gap:18px}.brand{display:flex;align-items:center;gap:9px;font-size:21px;font-weight:800;color:var(--ink);text-decoration:none}.brand-mark{width:30px;height:30px;border-radius:6px;background:var(--green);color:white;display:grid;place-items:center}.header-note{margin-left:auto;display:flex;align-items:center;gap:7px;color:var(--muted);font-size:12px}.auth-shell{display:grid;grid-template-columns:245px minmax(0,1fr);gap:70px;padding:48px 0 64px;min-height:calc(100vh - 148px)}.journey{border-right:1px solid var(--line);padding-right:28px}.journey-title{font-weight:700;margin-bottom:18px}.journey-list{list-style:none;padding:0;margin:0;display:grid;gap:5px}.journey-step{display:grid;grid-template-columns:30px 1fr;gap:10px;align-items:start;padding:10px 8px;border-radius:6px;color:#7a837e}.journey-step .step-dot{width:26px;height:26px;border:1px solid #cfd7d2;border-radius:50%;display:grid;place-items:center;font-size:11px;background:white}.journey-step strong{display:block;font-size:13px}.journey-step small{display:block;line-height:1.45}.journey-step.active{background:var(--green-soft);color:#28674f}.journey-step.active .step-dot{background:var(--green);border-color:var(--green);color:white}.journey-step.done{color:#3f6252}.journey-step.done .step-dot{border-color:#80af98;color:var(--green)}.privacy-note{margin-top:24px;padding-top:20px;border-top:1px solid var(--line);display:flex;gap:8px;color:var(--muted);font-size:11px}.privacy-note svg{flex:0 0 auto;margin-top:2px}.auth-main{width:min(100%,700px)}.page-head{margin-bottom:28px}.page-head .eyebrow{display:flex;align-items:center;gap:7px;color:var(--green);font-size:12px;font-weight:700;margin-bottom:7px}.page-head p{margin-top:9px;color:var(--muted);max-width:610px}.form{display:grid;gap:18px}.field{display:grid;gap:7px}.field-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.field label,.field-label{font-size:13px;font-weight:700}.optional{font-size:11px;color:var(--muted);font-weight:400}.control{width:100%;min-height:44px;border:1px solid #cbd5cf;border-radius:6px;background:white;padding:9px 11px;outline:0}.control:focus{border-color:var(--green);box-shadow:0 0 0 3px #dcede5}.control::placeholder{color:#9ba29e}.control-area{min-height:86px;resize:vertical}.input-action{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:9px}.segmented{display:grid;grid-template-columns:1fr 1fr;background:#f0f3f1;padding:3px;border-radius:6px;margin-bottom:21px}.segment{border:0;background:transparent;border-radius:4px;padding:9px;font-weight:600;color:#69726d}.segment.active{background:white;color:var(--green);box-shadow:0 1px 4px #22372c14}.button{min-height:42px;padding:8px 15px;border-radius:6px;border:1px solid var(--line);background:white;display:inline-flex;align-items:center;justify-content:center;gap:7px;font-weight:700;font-size:13px;text-decoration:none}.button.primary{background:var(--green);border-color:var(--green);color:white}.button.secondary{border-color:#adcabc;color:#28674f}.button.text{border:0;padding-left:5px;padding-right:5px;color:var(--green)}.button.danger{color:var(--red);border-color:#e6c3c1}.actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding-top:5px}.actions .push{margin-left:auto}.form-note{padding:11px 13px;border-left:3px solid #7aa98f;background:#f1f6f3;color:#4d6659;font-size:12px}.demo-credentials{display:grid;grid-template-columns:auto 1fr;gap:4px 12px;padding:13px 15px;background:var(--soft);border-radius:6px;font-size:12px}.demo-credentials dt{font-weight:700}.demo-credentials dd{margin:0;color:var(--muted)}.error-box,.success-box,.warning-box{display:flex;gap:9px;padding:11px 13px;border-radius:6px;font-size:12px}.error-box{background:var(--red-soft);color:var(--red)}.success-box{background:var(--green-soft);color:#28674f}.warning-box{background:var(--amber-soft);color:var(--amber)}.choice-row{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.choice{border:1px solid var(--line);border-radius:7px;background:white;padding:16px;text-align:left;display:flex;gap:12px}.choice:hover{border-color:#9ebcad}.choice .choice-icon{width:34px;height:34px;border-radius:6px;background:var(--green-soft);color:var(--green);display:grid;place-items:center;flex:0 0 auto}.choice p{font-size:12px;color:var(--muted);margin-top:3px}.status-band{display:flex;align-items:center;gap:12px;padding:15px 0 22px;border-bottom:1px solid var(--line);margin-bottom:4px}.status-band .avatar{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--green-soft);color:var(--green);font-weight:800}.status-band .account-meta{min-width:0}.status-band .account-meta p{font-size:12px;color:var(--muted);overflow-wrap:anywhere}.status-band .status-chip{margin-left:auto}.status-chip{display:inline-flex;align-items:center;gap:5px;border-radius:4px;padding:4px 8px;font-size:11px;background:var(--soft);color:#68716c;white-space:nowrap}.status-chip.green{background:var(--green-soft);color:var(--green)}.status-chip.blue{background:var(--blue-soft);color:var(--blue)}.status-chip.purple{background:var(--purple-soft);color:var(--purple)}.status-chip.amber{background:var(--amber-soft);color:var(--amber)}.status-chip.red{background:var(--red-soft);color:var(--red)}.identity-sections{display:grid}.identity-section{display:grid;grid-template-columns:165px minmax(0,1fr);gap:26px;padding:24px 0;border-bottom:1px solid var(--line)}.identity-section:last-child{border-bottom:0}.section-label p{font-size:12px;color:var(--muted);margin-top:4px}.section-body{min-width:0}.section-head{display:flex;align-items:center;gap:10px;margin-bottom:8px}.section-body>p{color:var(--muted);font-size:13px;margin-bottom:13px}.permission-list{display:flex;gap:7px;flex-wrap:wrap}.permission{border:1px solid var(--line);border-radius:4px;padding:4px 7px;font-size:11px;color:#747d78}.permission.on{border-color:#b7d4c5;background:#eef6f2;color:#28674f}.review-meta{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px 18px;padding:13px;background:var(--soft);border-radius:6px;margin:12px 0}.review-meta div{min-width:0}.review-meta small{display:block;color:var(--muted)}.review-meta strong{display:block;overflow-wrap:anywhere;font-size:12px}.file-placeholder{border:1px dashed #bcc9c1;border-radius:6px;padding:15px;display:flex;gap:10px;align-items:center;color:var(--muted);font-size:12px;background:#fafbfa}.simulator{margin-top:14px;padding:13px;border-left:3px solid #9e8aac;background:#f6f2f8}.simulator strong{font-size:12px}.simulator p{font-size:11px;color:var(--muted);margin:3px 0 8px}.invite-preview{padding:14px;border:1px solid #cfddd5;border-radius:6px;background:#f7faf8;margin-top:12px}.invite-preview h3{margin-bottom:6px}.invite-preview dl{display:grid;grid-template-columns:85px 1fr;gap:4px 10px;margin:0;font-size:12px}.invite-preview dt{color:var(--muted)}.invite-preview dd{margin:0;font-weight:600}.public-screen{padding:34px 0}.public-screen .public-icon{width:50px;height:50px;border-radius:8px;background:var(--green-soft);color:var(--green);display:grid;place-items:center;margin-bottom:16px}.public-screen .public-icon svg{width:26px;height:26px}.public-screen p{color:var(--muted);max-width:560px;margin:10px 0 22px}.footer{border-top:1px solid var(--line);padding:16px 0;color:#8a928e;font-size:11px}.footer-row{display:flex;justify-content:space-between;gap:18px}.toast{position:fixed;left:50%;bottom:22px;transform:translateX(-50%);background:#263a2d;color:white;border-radius:6px;padding:10px 15px;font-size:12px;box-shadow:0 5px 18px #0002;z-index:20;max-width:calc(100vw - 32px)}
</style>
<style>/*AUTH_CSS*/</style>
</head>
<body>
<div class="prototype-bar"><div class="wrap prototype-row"><strong>注册与认证交互草图</strong><span>本地模拟，请勿输入真实凭据</span><div class="demo-controls"><label for="demo-state">快速体验</label><select id="demo-state"><option value="visitor">游客</option><option value="unverified">未认证账号</option><option value="verified">校园已认证</option><option value="reviewing">组织审核中</option><option value="owner">组织负责人</option></select><button class="icon-button" id="reset-demo" type="button" title="重置演示" aria-label="重置演示"><span data-icon="RotateCcw"></span></button></div></div></div>
<header class="site-header"><div class="wrap header-row"><a class="brand" href="#"><span class="brand-mark" data-icon="Users"></span>CampusMate</a><div class="header-note"><span data-icon="ShieldCheck"></span><span>账号、校园身份和组织权限分层管理</span></div></div></header>
<main class="wrap auth-shell"><aside class="journey" aria-label="认证步骤"><div class="journey-title">账号与身份</div><ol class="journey-list" id="journey-list"></ol><div class="privacy-note"><span data-icon="LockKeyhole"></span><span>认证材料仅供审核使用，不进入公开资料，也不交给 AI 处理。</span></div></aside><section class="auth-main" id="auth-root" aria-live="polite"></section></main>
<footer class="footer"><div class="wrap footer-row"><span>CampusMate · 认证体验草图</span><span>虚构数据 · 不连接真实接口 · 不上传文件</span></div></footer>
<div class="toast" id="toast" role="status" hidden></div>
<script>/*ICON_DATA*/</script>
<script>/*AUTH_STATE*/</script>
<script>
const $ = id => document.getElementById(id);
const icon = name => window.ICONS[name] || '';
const escapeHTML = value => String(value == null ? '' : value).replace(/[&<>"']/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[char]));
const hydrateIcons = root => (root || document).querySelectorAll('[data-icon]').forEach(node => { node.innerHTML = icon(node.dataset.icon); });
</script>
<script>/*AUTH_UI*/</script>
</body>
</html>
