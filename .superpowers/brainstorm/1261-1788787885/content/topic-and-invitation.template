 if(state.channel==='casual'&&state.casualMode==='projects')return matchingProjects();
 const f=filter();let items=state.channel==='casual'?[...invitations]:topics.filter(t=>t.channel===state.channel);
 items=items.filter(t=>f.tags.every(id=>t.tags.includes(id))&&(!f.level||t.tags.includes(f.level))&&(!f.campus||t.campus===f.campus)&&(!f.open||t.status==='open')&&(!f.day||(f.day==='today'?t.date==='2026-09-08':f.day==='tomorrow'?t.date==='2026-09-09':['2026-09-12','2026-09-13'].includes(t.date))));
 if(f.sort==='soon'||(state.channel==='casual'&&f.sort!=='few'))items.sort((a,b)=>(a.date+(a.time||'')).localeCompare(b.date+(b.time||'')));
 if(f.sort==='popular')items.sort((a,b)=>b.followers-a.followers);if(f.sort==='few')items.sort((a,b)=>(a.status==='full')-(b.status==='full')||(a.total-a.joined)-(b.total-b.joined));return items;
}
function renderList(){
 syncRecruitments();
 if(state.channel==='casual'&&state.casualMode==='projects'){renderProjectList();return;}
 const items=matchingItems(),c=channelDefs[state.channel];const f=filter();
 $('result-count').textContent=`${items.length} 个${c.noun}${f.tags.length?' · '+f.tags.map(id=>tagById(id).name).join(' + '):''}${state.channel==='casual'?' · 2026.09.08 周二':' · 先了解活动，再决定参与'} `;
 const count=f.tags.length;$('mobile-filter-label').textContent='搜索'+(count?` (${count})`:'');
 if(!items.length){$('list-content').innerHTML=(state.channel==='casual'?casualModeSwitch():'')+`<div class="empty">${icon('Search')}<h3>暂无符合条件的${c.noun}</h3><p>可以减少标签，或清空筛选后查看其他内容。</p><button type="button" class="button" data-action="clear">清空筛选</button></div>`;return;}
 if(state.channel==='casual'){
 let previous='';let content='';items.forEach(t=>{if(t.date!==previous){content+=`<div class="day-heading"><strong>${dateHeading(t.date)}</strong><span>${t.date.slice(5).replace('-','月')}日</span></div>`;previous=t.date;}content+=invitationRow(t);});
 $('list-content').innerHTML=casualModeSwitch()+`<div class="invite-note">${icon('MapPin')}<span>校内具体邀约 · 公开展示场所范围，集合细节在确认后沟通</span></div>${content}`;
 }else $('list-content').innerHTML=`<div class="topic-grid">${items.map(topicCard).join('')}</div>`;
}
function dateHeading(date){return({'2026-09-08':'今天 · 周二','2026-09-09':'明天 · 周三','2026-09-12':'周六','2026-09-13':'周日'})[date]||date;}
function topicCard(t){return `<article class="topic-card"><button type="button" class="cover ${t.cover}" data-open="${t.id}" aria-label="查看${t.title}"><span><small>${state.channel==='official'?'COMPETITION / PROJECT':'CAMPUS / COMMUNITY'}</small><strong>${t.short}</strong></span><span class="cover-icon">${icon(t.icon)}</span></button><div class="card-body"><div class="card-source">${icon(t.channel==='official'?'ShieldCheck':'BadgeCheck')}${t.source} · ${t.organizer}</div><button type="button" class="card-title" data-open="${t.id}">${t.title}</button><p class="summary">${t.summary}</p><div class="badges">${t.tags.map(badge).join('')}</div><div class="card-date meta">${icon('CalendarDays')}${t.dateLabel}</div><div class="card-foot"><span class="meta">${icon('Heart')}<span class="count">${t.followers+Number(state.followed.has(t.id))}</span>人关注</span><button type="button" class="text-button" data-open="${t.id}" ${t.group?'data-subtab="teams"':''}>${t.group?`${t.teams.length} 条组队招募`:'查看活动详情'}${icon('ArrowRight')}</button></div></div></article>`;}
function invitationRow(t){return `<article class="invitation"><div class="time-rail">${t.time}<small>至 ${t.end}</small></div><div class="invite-main"><button type="button" class="card-title" data-open="${t.id}">${t.title}</button><div class="meta">${icon('MapPin')}${t.campus} · ${t.place}</div><div class="badges">${t.tags.map(badge).join('')}<span class="badge">${t.joined}/${t.total} 人</span></div><div class="invite-author"><span class="avatar">${t.author.slice(-1)}</span>${t.author}${icon('BadgeCheck')}<span>校园已认证</span></div></div><div class="invite-actions"><span class="${t.status==='open'?'slot':'muted'}">${t.status==='open'?'还差 '+(t.total-t.joined)+' 人':'已满员'}</span><button type="button" class="button" data-open="${t.id}">查看邀约${icon('ChevronRight')}</button></div></article>`;}
function openDetail(id,subtab='overview'){const record=topics.find(t=>t.id===id)||invitations.find(t=>t.id===id)||projects.find(t=>t.id===id);if(!record)return;state.channel=record.channel||'casual';if(state.channel==='casual')state.casualMode=projects.some(p=>p.id===id)?'projects':'daily';state.view='detail';state.detailId=id;state.subtab=subtab;render();window.scrollTo(0,0);}
function backToList(){state.view='browse';state.detailId=null;render();window.scrollTo(0,0);}
function renderDetail(){
 if(projects.some(t=>t.id===state.detailId)){renderProjectDetail(projects.find(t=>t.id===state.detailId));return;}
 syncRecruitments();
 const t=topics.find(t=>t.id===state.detailId)||invitations.find(t=>t.id===state.detailId);const isInvite=!t.channel;
 const crumb=`<div class="breadcrumb"><button type="button" class="text-button" data-action="back">${icon('ArrowLeft')}返回${isInvite?'校园搭子':'话题列表'}</button>${icon('ChevronRight')}<span>${isInvite?'邀约详情':'话题详情'}</span></div>`;
 if(isInvite){$('detail').innerHTML=crumb+invitationDetail(t);const disabled=$('detail').querySelector('.detail-side button');disabled.outerHTML=applicationAction(t.id);return;}
 const tabNames=[['overview','活动介绍'],['resources','相关资料'],...(t.group?[['teams',`组队招募 (${t.teams.length})`]]:[])];if(!t.group&&state.subtab==='teams')state.subtab='overview';
 $('detail').innerHTML=crumb+`<div class="detail-layout"><section><div class="cover detail-cover ${t.cover}"><span><small>TOPIC / ${t.channel==='official'?'OFFICIAL SOURCE':'VERIFIED ORGANIZATION'}</small><strong>${t.short}</strong></span><span class="cover-icon">${icon(t.icon)}</span></div><div class="detail-heading"><div class="card-source">${icon('ShieldCheck')}${t.source} · ${t.organizer}</div><h1>${t.title}</h1><div class="badges">${t.tags.map(badge).join('')}</div><p>${t.summary}</p></div><nav class="subtabs" aria-label="话题内容">${tabNames.map(([key,label])=>`<button type="button" data-subtab-change="${key}" class="${state.subtab===key?'active':''}" aria-current="${state.subtab===key?'page':'false'}">${label}</button>`).join('')}</nav><div>${topicSection(t)}</div></section><aside class="detail-side"><section class="side-section"><h3>关注这个话题</h3><div class="side-stat">${icon('Heart')}<strong>${t.followers+Number(state.followed.has(t.id))}</strong>人关注</div><button type="button" class="button ${state.followed.has(t.id)?'chosen':''}" data-follow="${t.id}">${icon(state.followed.has(t.id)?'Check':'Bookmark')}${state.followed.has(t.id)?'已关注':'关注话题'}</button></section><section class="side-section"><h3>${t.group?'寻找队友':'活动参与'}</h3><p>${t.group?'本话题下有 '+t.teams.length+' 条学生招募。组队确认不等于已完成赛事官方报名。':'本活动按个人参与，不设置组队区。'}</p><button type="button" class="button primary" ${t.group?'data-subtab-change="teams"':'data-info="registration"'}>${t.group?'查看组队招募':'查看报名信息'}${icon('ArrowRight')}</button></section><section class="side-section"><h3>来源与更新</h3><div class="source-box"><span>${icon('Building2')}${t.organizer}</span><span>${icon('Clock')}示例核验时间：2026.09.08</span></div><p>${t.channel==='official'?'收录官方公开信息，不代表平台是赛事主办方。':'组织身份已核验；具体活动级别以活动通知为准。'}</p><button type="button" class="text-button small" data-info="source" style="margin-top:10px">查看来源记录${icon('ExternalLink')}</button></section></aside></div>`;
}
function topicSection(t){
 if(state.subtab==='resources')return `<section class="article-section"><h3>相关资料</h3>${['活动通知与报名说明',t.group?'组队规则与参赛要求':'参与须知与时间安排','资料更新记录'].map((name,i)=>`<div class="resource-row">${icon('FileText')}<div class="resource-text"><strong>${name}</strong><small>${t.organizer} · 示例条目</small></div><button type="button" class="button" data-resource="${i}">查看${icon('ExternalLink')}</button></div>`).join('')}</section>`;
 if(state.subtab==='teams')return `<section>${t.teams.map((team,i)=>`<article class="team-row"><div class="team-row-head"><h3>${team.title}</h3>${statusBadge(demoStore.posts[t.id+'-team-'+i].status)}</div><p>${team.summary}</p><div class="badges">${team.skills.map(skill=>`<span class="badge topic">${skill}</span>`).join('')}</div><div class="team-row-foot"><span class="meta">${icon('UserRound')}${team.name} · 校园已认证 · ${team.slots}</span><button type="button" class="button" data-team="${i}">查看招募${icon('ChevronRight')}</button></div></article>`).join('')}</section>`;
 return `<section class="article-section"><h3>活动概况</h3><p>${t.summary}本页统一整理活动信息与来源资料${t.group?'，学生招募集中在独立的组队区，避免散落在不同通知下':''}。</p><div class="fact-grid"><div class="fact"><small>关键时间</small><strong>${t.dateLabel}</strong></div><div class="fact"><small>参赛 / 活动人数</small><strong>${t.capacity}</strong></div><div class="fact"><small>活动归属</small><strong>${t.organizer}</strong></div><div class="fact"><small>校区范围</small><strong>${t.campus}</strong></div></div></section><section class="article-section"><h3>${t.group?'组队与报名':'参与安排'}</h3><p>${t.group?'先核对参赛资格、人数与截止时间，再联系合适的队友。双方在平台确认组队后，仍需按主办方要求另行完成正式报名。':'本活动按个人参与。请先查看相关资料中的报名渠道与参与要求，不需要创建队伍或招募帖。'}</p></section>`;
}
function invitationDetail(t){return `<div class="detail-layout"><section><div class="invite-detail-banner">${icon('Clock')}<strong>${dateHeading(t.date)} ${t.time}–${t.end}</strong><span class="small">${t.status==='full'?'已满员':'还差 '+(t.total-t.joined)+' 人'}</span></div><div class="detail-heading"><h1>${t.title}</h1><div class="badges">${t.tags.map(badge).join('')}<span class="badge">校内邀约</span></div></div><div class="invite-person"><span class="avatar">${t.author.slice(-1)}</span><div><strong>${t.author}</strong> <span class="badge org">校园已认证</span><p>${t.major}</p></div></div><section class="article-section"><h3>这次打算</h3><p>${t.summary}</p><div class="fact-grid"><div class="fact"><small>活动地点</small><strong>${t.campus} · ${t.place}</strong></div><div class="fact"><small>活动时间</small><strong>${t.date} ${t.time}–${t.end}</strong></div><div class="fact"><small>当前人数</small><strong>${t.joined} / ${t.total} 人（含发起人）</strong></div><div class="fact"><small>费用情况</small><strong>${t.cost}</strong></div></div></section><section class="article-section"><h3>希望你</h3><p>${t.requirement}</p></section><section class="article-section"><h3>参与确认</h3><div class="flowline"><span>表达意向</span>${icon('ArrowRight')}<span>临时沟通</span>${icon('ArrowRight')}<span>双方确认</span></div><p>具体集合位置在确认后沟通。请勿在公开内容中提供手机号或私人住址。</p></section></section><aside class="detail-side"><section class="side-section"><h3>本次邀约</h3><div class="side-stat">${icon('Users')}<strong>${t.joined} / ${t.total}</strong>人已确认</div><button type="button" class="button" disabled>${icon(t.status==='full'?'LockKeyhole':'Users')}${t.status==='full'?'已满员':'申请加入 · 暂未接入'}</button><p>本次邀约到 ${t.date.slice(5)} ${t.time} 截止。</p></section><section class="side-section"><h3>集合与变更</h3><p>场所范围：${t.campus} · ${t.place}。无法按时参加时，请提前与发起人沟通。</p></section></aside></div>`;}
function searchSuggestions(){
 const raw=$('tag-search').value.trim();if(!raw){closeSuggestions();return;}
 const casualItems=state.channel==='casual'?(state.casualMode==='projects'?projects:invitations):[];
 const result=window.DiscoverySearch.getSearchSuggestions({query:raw,channel:state.channel,topics,tags,casualItems,selectedTagIds:filter().tags});
 let content=result.direct.length?`<div class="suggestion-heading">${state.channel==='casual'?(state.casualMode==='projects'?'项目直达':'邀约直达'):'话题直达'}</div>`+result.direct.map(t=>`<button type="button" role="option" aria-selected="false" class="suggestion" data-open="${t.id}">${icon(state.channel==='casual'?'Users':'FileText')}<span class="suggestion-text"><strong>${escapeHTML(t.title)}</strong>${state.channel==='casual'?'':`<small>${escapeHTML(t.organizer)} · 点击进入话题</small>`}</span>${icon('ChevronRight')}</button>`).join(''):'';
 if(result.tags.length)content+='<div class="suggestion-heading">标准标签</div>'+result.tags.map(t=>`<button type="button" role="option" aria-selected="false" class="suggestion" data-add="${t.id}">${icon('Tag')}<span class="suggestion-text">${escapeHTML(t.name)}<small>用于筛选当前频道</small></span><span class="muted">${({level:'级别',org:'组织',topic:'主题'})[t.kind]}</span></button>`).join('');
 if(!content)content='<div class="no-suggestion">未找到标准标签或相关内容。可以换个名称试试，不会新建标签。</div>';
 $('suggestions').innerHTML=content;$('suggestions').hidden=false;$('tag-search').setAttribute('aria-expanded','true');
}
function clearFilters(){state.filters[state.channel]=freshFilter();renderBrowse();hydrateIcons();}
function setMobileFilters(){$('sidebar').classList.toggle('open',state.mobile);$('mobile-filters').setAttribute('aria-expanded',String(state.mobile));}
function showModal(title,body){$('modal-title').textContent=title;$('modal-body').innerHTML=body;$('modal').showModal();}
let toastTimer;function toast(message){clearTimeout(toastTimer);$('toast').textContent=message;$('toast').hidden=false;toastTimer=setTimeout(()=>$('toast').hidden=true,2600);}
document.addEventListener('click',event=>{
 const button=event.target.closest('button');if(!button){if(!event.target.closest('.search-wrap'))closeSuggestions();return;}
 if(button.dataset.channel){changeChannel(button.dataset.channel);return;}
 if(button.dataset.open){openDetail(button.dataset.open,button.dataset.subtab||'overview');closeSuggestions();return;}
 if(button.dataset.add){const id=button.dataset.add;if(!filter().tags.includes(id))filter().tags.push(id);$('tag-search').value='';closeSuggestions();renderSelected();renderList();$('tag-search').focus();return;}
 if(button.dataset.remove){filter().tags=filter().tags.filter(id=>id!==button.dataset.remove);renderSelected();renderList();return;}
 if(button.dataset.action==='clear'){clearFilters();return;}if(button.dataset.action==='back'){backToList();return;}
 if(button.dataset.subtabChange){state.subtab=button.dataset.subtabChange;renderDetail();return;}
 if(button.dataset.follow){const id=button.dataset.follow;state.followed.has(id)?state.followed.delete(id):state.followed.add(id);persistDemo();renderDetail();toast(state.followed.has(id)?'已在本次草图中关注':'已取消关注');return;}
 if(button.dataset.team!==undefined){openRecruitment(state.detailId+'-team-'+button.dataset.team);return;}
 if(button.dataset.info||button.dataset.resource!==undefined){const t=topics.find(t=>t.id===state.detailId);const key=button.dataset.info;showModal(key==='registration'?'报名信息':key==='source'?'来源记录':'资料预览',key==='registration'?`<p>${t.title}按个人参与，报名渠道应来自主办方的原始通知。</p><p>本话题为示例，尚未配置真实报名链接，不会跳转到不明地址。</p>`:`<p><strong>${t.title}</strong><br>归属：${t.organizer}<br>资料类型：${t.channel==='official'?'官方通知收录':'认证组织提交'}<br>示例核验时间：2026.09.08</p><p>正式版本将保留原文链接、发布时间、规则附件与变更记录。本草图未配置真实文件或原始通知。</p>`);}
});
$('tag-search').addEventListener('input',searchSuggestions);$('tag-search').addEventListener('focus',searchSuggestions);
$('tag-search').addEventListener('keydown',event=>{if(event.key==='Escape')closeSuggestions();if(event.key==='ArrowDown'&&!$('suggestions').hidden){event.preventDefault();$('suggestions').querySelector('button')?.focus();}if(event.key==='Enter'){event.preventDefault();if(!$('suggestions').hidden)$('suggestions').querySelector('button')?.click();}});
$('suggestions').addEventListener('keydown',event=>{const nodes=[...$('suggestions').querySelectorAll('button')],index=nodes.indexOf(document.activeElement);if(['ArrowDown','ArrowUp'].includes(event.key)){event.preventDefault();nodes[(index+(event.key==='ArrowDown'?1:-1)+nodes.length)%nodes.length]?.focus();}if(event.key==='Escape'){$('tag-search').focus();closeSuggestions();}});
$('sort').onchange=event=>{filter().sort=event.target.value;renderList();};
$('mobile-filters').onclick=()=>{state.mobile=!state.mobile;setMobileFilters();if(state.mobile)$('sidebar').scrollIntoView({block:'start',behavior:'smooth'});};
$('view-policy').onclick=()=>{state.view='policy';render();window.scrollTo(0,0);};$('view-browse').onclick=backToList;
$('brand').onclick=event=>{event.preventDefault();changeChannel('official');};$('close-modal').onclick=()=>$('modal').close();
$('modal').addEventListener('click',event=>{if(event.target===$('modal')){const r=$('modal').getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)$('modal').close();}});
$('saved-button').onclick=()=>{state.profileTab='saved';goWorkspace('profile');};
/*WORKSPACE_UI*/
/*PUBLISHING_UI*/
render();
</script>
</body>
</html>
