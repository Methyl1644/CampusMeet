# 后端数据库连接字符串
# 本地留空时自动使用仓库根目录下的 SQLite 数据库 campusmate.db；部署时必须配置 PostgreSQL。
DATABASE_URL=

# Render 等正式部署环境必须设为 production；本地开发可保持 development。
APP_ENV=development

# 本地 SQLite 返回验证码供联调；部署时必须改为 false，并配置真实邮件/短信服务。
AUTH_TEST_MODE=true

# 访问控制：public 为正常开放；allowlist 仅允许 AUTH_ALLOWED_EMAILS 中的邮箱。
AUTH_ACCESS_MODE=public
AUTH_ALLOWED_EMAILS=

# 拥有平台高级运营与正式活动发布能力的工作人员邮箱；与登录白名单分开配置。
STAFF_EMAILS=

# 本地只启动 REST API；Coze 运行环境配置好模型凭据后再开启 Agent 运行时。
ENABLE_AGENT_RUNTIME=false
# 仅在启用旧 Agent HTTP 运行入口时需要，必须使用高强度随机值。
AGENT_RUNTIME_TOKEN=

# 已注册账号对应邮箱；服务启动时会把该账号设为首位平台运营者。
BOOTSTRAP_OPERATOR_EMAIL=

# 允许访问后端的前端网址，多个网址用英文逗号分隔。
FRONTEND_ORIGINS=http://localhost:5173

# Neon 连接池上限。免费实例建议保持较小值。
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# 注册允许的校园邮箱域名，仅接受南大学生邮箱和教职工邮箱。
CAMPUS_EMAIL_DOMAINS=nju.edu.cn,smail.nju.edu.cn

# JWT 密钥（用于生成和验证用户登录 Token）
JWT_SECRET=your_jwt_secret_here
ACCESS_TOKEN_TTL_SECONDS=86400
# 可单独设置验证码摘要密钥；留空时复用 JWT_SECRET。
OTP_HASH_SECRET=
NOTIFICATION_RETENTION_DAYS=180
PERMISSION_EXPIRY_REMINDER_DAYS=7
REJECTED_EVIDENCE_RETENTION_DAYS=30

# ============================================================
# SMTP 邮件配置（验证码邮件发送，可选）
# 未配置时验证码将直接返回（测试模式），不影响注册流程
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# Render 部署优先使用 Brevo 的 HTTPS 事务邮件接口。
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=CampusMate
BREVO_API_BASE_URL=https://api.brevo.com/v3

# 可选备用通道；仅在未配置 Brevo 时使用。
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_API_BASE_URL=https://api.resend.com

# ============================================================
# Coze 部署 API（推荐）：工作流部署后复制 .coze.site/run 地址。
# Token 只放后端环境变量，不得提交到仓库或放入前端。
# ============================================================
COZE_DEPLOY_API_TOKEN=
COZE_POST_DRAFT_API_URL=https://<your-deployment>.coze.site/run
COZE_CLASSIFY_REVIEW_API_URL=
COZE_MATCH_API_URL=
COZE_TEAM_PLAN_API_URL=

# 行为风控仅保存 HMAC 指纹；生产环境使用独立随机密钥。
ABUSE_HASH_SECRET=

# S3 兼容对象存储（组织认证材料使用私有前缀）
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# 旧版工作流 ID 调用方式（可选后备）。
# Coze API 令牌
COZE_API_TOKEN=your_coze_api_token
# Coze API 基础地址（默认 https://api.coze.cn）
COZE_API_BASE_URL=https://api.coze.cn

# AI 发帖助手工作流 ID（F03）；留空时自动使用 LLM fallback
COZE_WORKFLOW_POST_DRAFT=

# 帖子分类审核工作流 ID（F06）；留空时自动使用 LLM fallback
COZE_WORKFLOW_CLASSIFY_REVIEW=

# 队友匹配工作流 ID（F13）；仅作为部署 API 的后备
COZE_WORKFLOW_MATCH=

# 团队规划工作流 ID（F12）；仅作为部署 API 的后备
COZE_WORKFLOW_TEAM_PLAN=

# ============================================================
# 前端 API 地址（前端使用）
# ============================================================
# 前端 dev server 通过 vite.config.ts 的 proxy 把 /api 转发到后端 3000 端口
# 本地开发无需设置此项；部署时填后端地址
VITE_API_BASE_URL=http://localhost:3000
