# 后端数据库连接字符串
PGDATABASE_URL=postgresql://user:password@localhost:5432/campusmate

# JWT 密钥（用于生成和验证用户登录 Token）
JWT_SECRET=your_jwt_secret_here

# ============================================================
# SMTP 邮件配置（验证码邮件发送，可选）
# 未配置时验证码将直接返回（测试模式），不影响注册流程
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# ============================================================
# Coze 工作流配置（可选）
# 配置后 AI 工具将优先调用 Coze 工作流，未配置时使用内置 LLM 后备方案
# 工作流 ID 在 Coze 平台创建工作流后获取
# ============================================================
# Coze API 令牌
COZE_API_TOKEN=your_coze_api_token
# Coze API 基础地址（默认 https://api.coze.cn）
COZE_API_BASE_URL=https://api.coze.cn

# AI 发帖助手工作流 ID（F03: 根据描述自动生成结构化帖子）
COZE_WORKFLOW_POST_DRAFT_ID=

# 帖子分类审核工作流 ID（F06: AI 辅助分类与风险审核）
COZE_WORKFLOW_CLASSIFY_REVIEW_ID=

# 队友匹配工作流 ID（F13: 根据技能/时间/角色智能匹配）
COZE_WORKFLOW_MATCH_TEAMMATES_ID=

# 团队规划工作流 ID（F12: 生成分工/议程/任务清单/风险提醒）
COZE_WORKFLOW_TEAM_PLAN_ID=

# ============================================================
# 前端 API 地址（前端使用）
# ============================================================
# 前端 dev server 通过 vite.config.ts 的 proxy 把 /api 转发到后端 3000 端口
# 本地开发无需设置此项；部署时填后端地址
VITE_API_BASE_URL=http://localhost:3000
