# 后端数据库连接字符串
# 本地留空时自动使用仓库根目录下的 SQLite 数据库 campusmate.db；部署时必须配置 PostgreSQL。
DATABASE_URL=

# 本地 SQLite 返回验证码供联调；部署时必须改为 false，并配置真实邮件/短信服务。
AUTH_TEST_MODE=true

# 本地只启动 REST API；Coze 运行环境配置好模型凭据后再开启 Agent 运行时。
ENABLE_AGENT_RUNTIME=false
# 仅在启用旧 Agent HTTP 运行入口时需要，必须使用高强度随机值。
AGENT_RUNTIME_TOKEN=

# 已注册账号对应邮箱；服务启动时会把该账号设为首位平台运营者。
BOOTSTRAP_OPERATOR_EMAIL=

# 允许访问后端的前端网址，多个网址用英文逗号分隔。
FRONTEND_ORIGINS=http://localhost:5173

# Neon 连接池上限。免费实例建议保持较小值。
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# 注册允许的校园邮箱域名，仅接受南大学生邮箱和教职工邮箱。
CAMPUS_EMAIL_DOMAINS=nju.edu.cn,smail.nju.edu.cn

# JWT 密钥（用于生成和验证用户登录 Token）
JWT_SECRET=your_jwt_secret_here
# 可单独设置验证码摘要密钥；留空时复用 JWT_SECRET。
OTP_HASH_SECRET=

# ============================================================
# SMTP 邮件配置（验证码邮件发送，可选）
# 未配置时验证码将直接返回（测试模式），不影响注册流程
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# Render 部署优先使用 Brevo 的 HTTPS 事务邮件接口。
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=CampusMate
BREVO_API_BASE_URL=https://api.brevo.com/v3

# 可选备用通道；仅在未配置 Brevo 时使用。
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_API_BASE_URL=https://api.resend.com

# ============================================================
# Coze 工作流配置（可选）
# 配置后 AI 工具将优先调用 Coze 工作流，未配置时使用内置 LLM 后备方案
# 工作流 ID 在 Coze 平台创建工作流后获取
# ============================================================
# Coze API 令牌
COZE_API_TOKEN=your_coze_api_token
# Coze API 基础地址（默认 https://api.coze.cn）
COZE_API_BASE_URL=https://api.coze.cn

# AI 发帖助手工作流 ID（F03）；留空时自动使用 LLM fallback
COZE_WORKFLOW_POST_DRAFT=

# 帖子分类审核工作流 ID（F06）；留空时自动使用 LLM fallback
COZE_WORKFLOW_CLASSIFY_REVIEW=

# 队友匹配工作流 ID（F13）；受控上下文接口未接入时建议留空
COZE_WORKFLOW_MATCH=

# 团队规划工作流 ID（F12）；留空时自动使用 LLM + 数据库 fallback
COZE_WORKFLOW_TEAM_PLAN=

# ============================================================
# 前端 API 地址（前端使用）
# ============================================================
# 前端 dev server 通过 vite.config.ts 的 proxy 把 /api 转发到后端 3000 端口
# 本地开发无需设置此项；部署时填后端地址
VITE_API_BASE_URL=http://localhost:3000
